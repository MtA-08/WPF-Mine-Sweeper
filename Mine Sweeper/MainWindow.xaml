<Window x:Class="Mine_Sweeper.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Mine_Sweeper"
        mc:Ignorable="d"
		x:Name="MineSweeper"
		WindowState="Normal"
		WindowStyle="SingleBorderWindow"
		ResizeMode="NoResize"
		Style="{StaticResource MainWindowStyle}">
	<Window.Resources>
		<DataTemplate x:Key="CellTemplate">
			<Button x:Name="CellButton" Click="GridButton_Click" PreviewMouseUp="Button_PreviewMouseUp" Style="{StaticResource CellButtonStyle}"/>
			<DataTemplate.Triggers>
				<DataTrigger Binding="{Binding State}" Value="{x:Static local:CellVisibleState.ClickedHasNoNeighbouringMines}">
					<Setter TargetName="CellButton" Property="Style" Value="{StaticResource HasNoNeighbouringMinesClickedStyle}"/>
				</DataTrigger>

				<DataTrigger Binding="{Binding State}" Value="{x:Static local:CellVisibleState.ClickedHasNeighbouringMines}">
					<Setter TargetName="CellButton" Property="Style" Value="{StaticResource HasNeighbouringMineStyle}"/>
				</DataTrigger>

				<DataTrigger Binding="{Binding State}" Value="{x:Static local:CellVisibleState.IsFlagged}">
					<Setter TargetName="CellButton" Property="Style" Value="{StaticResource FlaggedCellStyle}"/>
				</DataTrigger>

				<DataTrigger Binding="{Binding State}" Value="{x:Static local:CellVisibleState.HasMineClicked}">
					<Setter TargetName="CellButton" Property="Style" Value="{StaticResource MineClickedCellStyle}"/>
				</DataTrigger>
			</DataTemplate.Triggers>
		</DataTemplate>
	</Window.Resources>
	
    <Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" MinHeight="50" />
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto" MinHeight="50"/>
		</Grid.RowDefinitions>

		<Border BorderBrush="#999999" BorderThickness="0,0,0,1">
			<Grid Grid.Row="0">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="90"/>
					<ColumnDefinition Width="90"/>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="180"/>
				</Grid.ColumnDefinitions>
				
				<Border BorderBrush="#999999" BorderThickness="1" HorizontalAlignment="Left" Margin="10,5,2,5" Grid.Column="0" CornerRadius="10">
					<WrapPanel Width="80" Height="Auto" VerticalAlignment="Center" HorizontalAlignment="Center"  >
						<Viewbox Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="5">
							<Path Data="{StaticResource Mine}" Fill="White"/>
						</Viewbox>
						<TextBlock x:Name="RemainingMinesTextblock" Text="{Binding RemainingMineCount}" Foreground="White" FontSize="16" Margin="5"/>
					</WrapPanel>
				</Border>
				<Border BorderBrush="#999999" BorderThickness="1" HorizontalAlignment="Left" Margin="2,5,10,5" Grid.Column="1" CornerRadius="10">
					<WrapPanel Height="Auto" Width="80" VerticalAlignment="Center" HorizontalAlignment="Center">
						<Viewbox Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="5">
							<Path Data="{StaticResource TimerOutline}" Fill="White"/>
						</Viewbox>
						<TextBlock x:Name="TimerDisplay" x:FieldModifier="public" Text="000" Foreground="White" FontSize="16" Margin="5"/>
					</WrapPanel>
				</Border>
				<Button Style="{StaticResource NewGameButtonStyle}" Click="NewGameButton_Click" Grid.Column="2" Margin="10">
					<Viewbox Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="5">
						<Path Data="{StaticResource ArrowRotateRightSolid}" Fill="White"/>
					</Viewbox>
				</Button>
				<ComboBox x:Name="GridSizeComboBox" SelectionChanged="GridSizeComboBox_SelectionChanged" Style="{StaticResource DifficultySetterComboBoxStyle}" HorizontalAlignment="Right" Grid.Column="3">
					<ComboBoxItem Content="Einfach"/>
					<ComboBoxItem Content="Mittel"/>
					<ComboBoxItem Content="Schwer"/>
				</ComboBox>
			</Grid>
		</Border>

		<Grid Grid.Row="1">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*"/>
				<ColumnDefinition Width="700"/>
				<ColumnDefinition Width="*"/>
			</Grid.ColumnDefinitions>

			<TextBlock x:Name="ConditionText1" HorizontalAlignment="Center" VerticalAlignment="Center" Grid.Column="0" FontSize="30">
				<TextBlock.LayoutTransform>
					<RotateTransform Angle="-90"/>
				</TextBlock.LayoutTransform>
			</TextBlock>

			<ItemsControl x:Name="GameGridControl" ItemsSource="{Binding GridData}" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
				<ItemsControl.ItemsPanel>
					<ItemsPanelTemplate>
						<StackPanel Orientation="Vertical"/>
					</ItemsPanelTemplate>
				</ItemsControl.ItemsPanel>

				<ItemsControl.ItemTemplate>
					<DataTemplate>
						<ItemsControl ItemsSource="{Binding}" ItemTemplate="{StaticResource CellTemplate}">
							<ItemsControl.ItemsPanel>
								<ItemsPanelTemplate>
									<StackPanel Orientation="Horizontal"/>
								</ItemsPanelTemplate>
							</ItemsControl.ItemsPanel>
						</ItemsControl>
					</DataTemplate>
				</ItemsControl.ItemTemplate>
			</ItemsControl>

			<TextBlock x:Name="ConditionText2" HorizontalAlignment="Center" VerticalAlignment="Center" Grid.Column="2" FontSize="30">
				<TextBlock.LayoutTransform>
					<RotateTransform Angle="90"/>
				</TextBlock.LayoutTransform>
			</TextBlock>
		</Grid>

		<WrapPanel Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center">
			<Button Height="Auto" Width="Auto" Click="OpenPopup_Click" Content="Ergebnisse" Padding="10" VerticalAlignment="Center" Margin="5" FontSize="16" HorizontalAlignment="Center"/>
			<Button Height="Auto" Width="Auto" Click="ClearResults_Click" Padding="10" VerticalAlignment="Center" Margin="5">
				<Viewbox Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center">
					<Path Data="{StaticResource DeleteEmptyOutline}" Fill="Red"/>
				</Viewbox>
			</Button>
		</WrapPanel>
			<Popup x:Name="ResultsPopUp" StaysOpen="False"
			   Placement="Custom"  PlacementTarget="{Binding ElementName=MineSweeper}"
			   CustomPopupPlacementCallback="CenterPopup" Style="{StaticResource resultsPopUpStyle}">
			<Border Style="{StaticResource resultsPopUpBorderStyle}">
				<WrapPanel Orientation="Vertical">
					<ItemsControl x:Name="ResultsList" >

						<ItemsControl.Template>
							<ControlTemplate TargetType="ItemsControl">
								<ScrollViewer MaxHeight="700" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
									<ItemsPresenter />
								</ScrollViewer>
							</ControlTemplate>
						</ItemsControl.Template>

						<ItemsControl.ItemsPanel>
							<ItemsPanelTemplate>
								<WrapPanel  Orientation="Horizontal"/>
							</ItemsPanelTemplate>
						</ItemsControl.ItemsPanel>

						<ItemsControl.ItemTemplate>
							<DataTemplate>
								<Grid>
									<Border x:Name="ResultBorder" Width="310" Height="Auto" Padding="5" Margin="10" BorderThickness="2" CornerRadius="2" HorizontalAlignment="Center">
										<StackPanel>
											<TextBlock Text="{Binding RunId, StringFormat='Spiel Nummer: \{0\}'}" Style="{StaticResource resultsPopUpTextStyle}"/>
											<TextBlock Text="{Binding RunCompletonTime, StringFormat='Spielzeit: \{0\} Sekunden'}" Style="{StaticResource resultsPopUpTextStyle}"/>
											<TextBlock Text="{Binding RunResult, StringFormat='Ergebnis: \{0\}'}" Style="{StaticResource resultsPopUpTextStyle}"/>
											<TextBlock Text="{Binding RunDifficulty, StringFormat='Schwerigkeitslevel: \{0\}'}" Style="{StaticResource resultsPopUpTextStyle}"/>
											<TextBlock Text="{Binding RunDate, StringFormat='Abgeschlossen um: \{0\}'}" Style="{StaticResource resultsPopUpTextStyle}"/>
										</StackPanel>
									</Border>
								</Grid>
								<DataTemplate.Triggers>
									<DataTrigger Binding="{Binding RunResult}" Value="Gewonnen">
										<Setter TargetName="ResultBorder" Property="BorderBrush" Value="DarkGreen"/>
									</DataTrigger>
									<DataTrigger Binding="{Binding RunResult}" Value="Verloren">
										<Setter TargetName="ResultBorder" Property="BorderBrush" Value="DarkRed"/>
									</DataTrigger>
								</DataTemplate.Triggers>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>
				</WrapPanel>
			</Border>
		</Popup>

	</Grid>
</Window>
