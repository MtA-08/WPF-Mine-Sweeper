<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
	<ResourceDictionary.MergedDictionaries>
		<ResourceDictionary Source="/icons.xaml"/>
	</ResourceDictionary.MergedDictionaries>
	<!-- Main Window -->
	<Style x:Key="MainWindowStyle" TargetType="Window">
		<Setter Property="Background" Value="#161518"/>
		<Setter Property="Title" Value="Mine Sweeper"/>
	</Style>

	<Style x:Key="NewGameButtonBorderStyle" TargetType="Border">
		<Setter Property="BorderThickness" Value="1"/>
		<Setter Property="BorderBrush" Value="#037D00"/>
		<Setter Property="Background" Value="#035E00"/>
		<Setter Property="CornerRadius" Value="10"/>
	</Style>

	<Style x:Key="NewGameButtonStyle" TargetType="Button">
		<Setter Property="Height" Value="40"/>
		<Setter Property="Width" Value="40"/>
		<Setter Property="Foreground" Value="White"/>
		<Setter Property="Margin" Value="1"/>
		<Setter Property="Cursor" Value="Hand"/>
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="Button">
					<Border Style="{StaticResource NewGameButtonBorderStyle}">
						<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
					</Border>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<Style x:Key="DifficultySetterComboBoxStyle" TargetType="{x:Type ComboBox}">
		<Setter Property="Height" Value="Auto"/>
		<Setter Property="Width" Value="150"/>
		<Setter Property="Padding" Value="5"/>
		<Setter Property="Margin" Value="10"/>
		<Setter Property="VerticalContentAlignment" Value="Center"/>
		<Setter Property="HorizontalContentAlignment" Value="Center"/>
		<Setter Property="VerticalAlignment" Value="Center"/>
		<Setter Property="FontSize" Value="16"/>
		<Setter Property="Foreground" Value="Black"/>
		<Setter Property="IsEditable" Value="False"/>
	</Style>

	<Style x:Key="CellButtonBorderStyle" TargetType="Border">
		<Setter Property="BorderThickness" Value="1"/>
		<Setter Property="BorderBrush" Value="#999999"/>
		<Setter Property="CornerRadius" Value="3"/>
	</Style>

	<Style x:Key="CellButtonStyle" TargetType="Button">
		<Setter Property="Height" Value="30"/>
		<Setter Property="Width" Value="30"/>
		<Setter Property="Margin" Value="1"/>
		<Setter Property="Cursor" Value="Hand"/>
		<Setter Property="Background" Value="#4F4F4F"/>
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="Button">
					<Border Style="{StaticResource CellButtonBorderStyle}" Background="{TemplateBinding Background}">
						<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
					</Border>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<DataTemplate x:Key="FlagContentTemplate">
		<Viewbox Width="20" Height="20">
			<Path Data="{StaticResource FlagOutline}" Fill="White"/>
		</Viewbox>
	</DataTemplate>

	<DataTemplate x:Key="MineClickedContentTemplate">
		<Viewbox Width="20" Height="20">
			<Path Data="{StaticResource Mine}" Fill="Red"/>
		</Viewbox>
	</DataTemplate>

	<DataTemplate x:Key="HasNeighbouringMinesTemplate">

		<Viewbox Width="20" Height="20">
			<Path x:Name="NumberIcon"/>
		</Viewbox>

		<DataTemplate.Triggers>
			<DataTrigger Binding="{Binding NeighbouringMines}" Value="1">
				<Setter TargetName="NumberIcon" Property="Data" Value="{StaticResource _1Solid}"/>
				<Setter TargetName="NumberIcon" Property="Fill" Value="#0100fc"/>
			</DataTrigger>

			<DataTrigger Binding="{Binding NeighbouringMines}" Value="2">
				<Setter TargetName="NumberIcon" Property="Data" Value="{StaticResource _2Solid}"/>
				<Setter TargetName="NumberIcon" Property="Fill" Value="#017e00"/>
			</DataTrigger>

			<DataTrigger Binding="{Binding NeighbouringMines}" Value="3">
				<Setter TargetName="NumberIcon" Property="Data" Value="{StaticResource _3Solid}"/>
				<Setter TargetName="NumberIcon" Property="Fill" Value="#f70305"/>
			</DataTrigger>

			<DataTrigger Binding="{Binding NeighbouringMines}" Value="4">
				<Setter TargetName="NumberIcon" Property="Data" Value="{StaticResource _4Solid}"/>
				<Setter TargetName="NumberIcon" Property="Fill" Value="#010080"/>
			</DataTrigger>

			<DataTrigger Binding="{Binding NeighbouringMines}" Value="5">
				<Setter TargetName="NumberIcon" Property="Data" Value="{StaticResource _5Solid}"/>
				<Setter TargetName="NumberIcon" Property="Fill" Value="#7f0102"/>
			</DataTrigger>

			<DataTrigger Binding="{Binding NeighbouringMines}" Value="6">
				<Setter TargetName="NumberIcon" Property="Data" Value="{StaticResource _6Solid}"/>
				<Setter TargetName="NumberIcon" Property="Fill" Value="#00807f"/>
			</DataTrigger>

			<DataTrigger Binding="{Binding NeighbouringMines}" Value="7">
				<Setter TargetName="NumberIcon" Property="Data" Value="{StaticResource _7Solid}"/>
				<Setter TargetName="NumberIcon" Property="Fill" Value="#000000"/>
			</DataTrigger>

			<DataTrigger Binding="{Binding NeighbouringMines}" Value="8">
				<Setter TargetName="NumberIcon" Property="Data" Value="{StaticResource _8Solid}"/>
				<Setter TargetName="NumberIcon" Property="Fill" Value="#808080"/>
			</DataTrigger>

		</DataTemplate.Triggers>

	</DataTemplate>

	<DataTemplate x:Key="HasNoNeighbouringMinesClickedTemplate">
	</DataTemplate>

	<Style x:Key="FlaggedCellStyle" TargetType="Button" BasedOn="{StaticResource CellButtonStyle}">
		<Setter Property="Content" Value="{Binding}"/>
		<Setter Property="ContentTemplate" Value="{StaticResource FlagContentTemplate}"/>
		<Setter Property="Background" Value="#212121"/>
	</Style>

	<Style x:Key="MineClickedCellStyle" TargetType="Button" BasedOn="{StaticResource CellButtonStyle}">
		<Setter Property="Content" Value="{Binding}"/>
		<Setter Property="ContentTemplate" Value="{StaticResource MineClickedContentTemplate}"/>
		<Setter Property="Background" Value="#212121"/>
	</Style>

	<Style x:Key="HasNeighbouringMineStyle" TargetType="Button" BasedOn="{StaticResource CellButtonStyle}">
		<Setter Property="Content" Value="{Binding}"/>
		<Setter Property="ContentTemplate" Value="{StaticResource HasNeighbouringMinesTemplate}"/>
		<Setter Property="Background" Value="#212121"/>
	</Style>

	<Style x:Key="HasNoNeighbouringMinesClickedStyle" TargetType="Button" BasedOn="{StaticResource CellButtonStyle}">
		<Setter Property="Content" Value="{Binding}"/>
		<Setter Property="ContentTemplate" Value="{StaticResource HasNoNeighbouringMinesClickedTemplate}"/>
		<Setter Property="Background" Value="#212121"/>
	</Style>

	<!-- Results PopUp Style -->
	<Style x:Key="resultsPopUpStyle" TargetType="Popup">
		<Setter Property="Height" Value="700"/>
		<Setter Property="Width" Value="700"/>
	</Style>

	<!-- Results PopUp Border Style -->
	<Style x:Key="resultsPopUpBorderStyle" TargetType="Border">
		<Setter Property="Background" Value="#2b2b2b"/>
		<Setter Property="CornerRadius" Value=" 10"/>
		<Setter Property="BorderThickness" Value="1"/>
		<Setter Property="BorderBrush" Value="#999999"/>
	</Style>

	<!-- Pop Up Schliesen Button Border Style -->
	<Style x:Key="popUpSchliesenButtonBorderStyle" TargetType="Border">
		<Setter Property="CornerRadius" Value="10"/>
		<Setter Property="BorderThickness" Value="1"/>
		<Setter Property="BorderBrush" Value="#999999"/>
		<Setter Property="Background" Value="Red"/>
		<Setter Property="Height" Value="30"/>
		<Setter Property="Width" Value="30"/>
	</Style>

	<!-- Pop Up Schliesen Button Style -->
	<Style x:Key="popUpSchliesenButtonStyle" TargetType="Button">
		<Setter Property="HorizontalAlignment" Value="Left"/>
		<Setter Property="VerticalAlignment" Value="Center" />
		<Setter Property="Margin" Value="30"/>
		<Setter Property="Foreground" Value="White"/>
		<Setter Property="Cursor" Value="Hand"/>
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="Button">
					<Border Style="{StaticResource popUpSchliesenButtonBorderStyle}">
						<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
					</Border>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<!-- Results PopUp Text Style -->
	<Style x:Key="resultsPopUpTextStyle" TargetType="TextBlock">
		<Setter Property="Margin" Value="0,4"/>
		<Setter Property="FontSize" Value="16"/>
		<Setter Property="Foreground" Value="White"/>
	</Style>

</ResourceDictionary>